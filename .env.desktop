# ============================================
# 桌面端（Tauri）构建专用环境
# 用法：npm run build:desktop   →  vite build --mode desktop
# ============================================
#
# 为什么单独一个文件：桌面端的「能用」与 Web 端的三条前提直接冲突，
# 而 .env.local（开发）/ 生产部署配置都不能动，只能按 mode 分开。
#
# 与 Web 构建的差别：
#   1. BASE_URL 必须是 /（vite.config.ts 在 desktop 模式下已强制为 /，
#      这里写出来只是让「为什么是 /」这件事在配置里可见）。
#      Web 产物默认 /app/，装进 Tauri 会整片 404。
#   2. COMMUNITY_API 必须留空或写绝对地址。
#      写 "/" 表示「与前端同源」，而桌面端的 origin 是 tauri.localhost，
#      后面根本没有后端 —— src/utils/cdkService.ts 在桌面端会把 "/" 判为不可用并
#      退回纯 BYOK，但更干净的做法是这里就留空，连兑换码入口都不显示。
#   3. LLM_BASE_URL / LLM_API_KEY 在这里**没有意义**：它们只服务于 Vite 开发代理，
#      桌面端没有 dev server。桌面端一律由用户在应用内填 BYOK（存 localStorage）。
#      把 Key 写进这里会被打进前端包 —— 那是泄露，不是配置。

BASE_URL=/

# 留空 = 纯开源自托管模式（只显示 BYOK 配置页）。
# 如果你有自己的社区后端并配了 CORS，可以写成 https://api.example.com，
# 桌面端会通过 Rust 侧发出请求（无 CORS 限制，但不带 Cookie）。
COMMUNITY_API=

# 默认模型名（会经 define 编译进前端，作为配置页的预填值）
LLM_MODEL=deepseek-v4-flash

ENABLE_THINKING=false
