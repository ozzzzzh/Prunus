# ============================================
# Prunus 环境变量配置说明
# 复制此文件为 .env.local（本地开发）或 .env（生产）
# ============================================

# ============================================
# 构建配置（影响 yarn run build 的输出路径）
# ============================================
# BASE_URL：部署子路径，默认 /app/
# - 如果部署到根路径（如 https://example.com/），设置为 /
# - 如果部署到子路径（如 https://example.com/app/），设置为 /app/
# - 开发环境（yarn dev）自动使用 /，无需设置
BASE_URL=/app/

# ============================================
# LLM API 配置（运行时使用）
# ============================================
# LLM Base URL（不带尾部斜杠）
# 示例：https://api.openai.com/v1 或 https://api.deepseek.com
LLM_BASE_URL=https://api.openai.com/v1

# LLM API Key（请使用你自己的 Key）
LLM_API_KEY=sk-your-api-key-here

# 默认模型名称
LLM_MODEL=gpt-3.5-turbo

# 是否启用思考（某些模型支持，如 GLM）
ENABLE_THINKING=false

# ============================================
# 社区版后端地址（可选）
# ============================================
# 用于 CDK 兑换 / 额度查询 / LLM 代理。三种写法：
#
#   （留空）                  纯开源自托管模式，只用 BYOK，不显示 CDK 入口
#   /                        与前端同源 ★ 推荐
#   https://api.example.com  独立域名，跨域，后端需配 CORS_ORIGIN
#
# 为什么推荐 "/"：
#   写成 "/" 时地址在**运行时**才解析（跟随当前页面的协议/主机/端口），
#   所以同一份构建产物既能跑在 IP 上也能跑在域名上，
#   换域名不需要重新构建。而且同源不触发 CORS，后端无需任何跨域配置。
#
# 注意：本文件在开发和生产下都会加载，且优先级低于 .env.production。
#   .env.local       本地开发用（指向本机后端）
#   .env.production  生产构建用（写成 "/"）
COMMUNITY_API=