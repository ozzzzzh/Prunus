{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prunus",
  "version": "0.1.21",
  "identifier": "com.prunus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Prunus",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright © Prunus contributors. Apache License 2.0.",
    "category": "Productivity",
    "shortDescription": "树状对话管理器",
    "longDescription": "Prunus 是一个树状对话管理器：从任意一条回复发散出多个分支，每条分支各自携带自己的上下文。会话数据全部保存在本机，只把你主动发送的消息发给自选的大模型服务。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": ["zh-CN"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
